# =============================================================================
# NAG Candidate Mobile — Docker Dev API Configuration
# Mirrors `infrastructure/docker-compose/docker-compose.monolith.yml` & `nginx.conf`
# =============================================================================

# Primary Docker API Gateway / Monolith container port (:9000)
EXPO_PUBLIC_API_BASE_URL=http://localhost:9000

# Android Emulator loopback to host Docker Gateway (:9000)
EXPO_PUBLIC_ANDROID_EMULATOR_API_URL=http://10.0.2.2:9000

# Docker `exam-candidate-delivery` Nginx proxy container (:4300)
EXPO_PUBLIC_DOCKER_NGINX_PROXY_URL=http://localhost:4300

# Internal Docker bridge (`exam-network`) upstream alias
EXPO_PUBLIC_DOCKER_INTERNAL_GATEWAY_URL=http://api-gateway:9000

# Docker Mock DPI Server (DigiLocker / Aadhaar e-KYC / MSG91 OTP) (:8099)
EXPO_PUBLIC_MOCK_SERVER_URL=http://localhost:8099

# Docker Local Tesseract OCR Service (:5005)
EXPO_PUBLIC_OCR_SERVICE_URL=http://localhost:5005

# Default Multi-Tenant Header
EXPO_PUBLIC_TENANT_ID=default
