{
  "name": "@nag/candidate-mobile-workspace",
  "version": "0.9.0",
  "private": true,
  "description": "NAG Official Candidate Mobile Application Workspace for Android (React Native + Expo + Hermes + Bridgeless TurboModules)",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build tsconfig.json",
    "test": "jest --config jest.config.js --runInBand",
    "lint": "tsc --noEmit -p packages/candidate-core/tsconfig.json && tsc --noEmit -p apps/candidate-mobile/tsconfig.json"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.18",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.2"
  }
}
