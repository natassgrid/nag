# =============================================================================
# Multi-stage Dockerfile for NAG Macro-Services
# Usage: docker build --build-arg APP_NAME=auth-admin-app -f backend/Dockerfile.macro -t exam/auth-admin-app .
# Must be built from the repo root (context = .)
# =============================================================================

# --- Stage 1: Build with Gradle ---
FROM exam/builder-base:latest AS builder

ARG APP_NAME

WORKDIR /workspace

COPY gradlew ./
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./
COPY backend/gradle/gradle-8.14.5-bin.zip /tmp/gradle-8.14.5-bin.zip

RUN sed -i 's/\r$//' gradlew && \
    chmod +x gradlew && \
    sed -i 's|distributionUrl=.*|distributionUrl=file\\:/tmp/gradle-8.14.5-bin.zip|' gradle/wrapper/gradle-wrapper.properties && \
    ./gradlew --version

COPY backend/ backend/

RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.gradle/wrapper \
    ./gradlew :backend:${APP_NAME}:bootJar -x test --no-daemon

# --- Stage 2: Runtime ---
FROM eclipse-temurin:21-jre-alpine

ARG APP_NAME
ENV APP_NAME=${APP_NAME}

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Asset storage directory writable by appuser (used by content-app for asset-service)
RUN mkdir -p /data/asset-storage && chown appuser:appgroup /data/asset-storage

COPY --from=builder /workspace/backend/${APP_NAME}/build/libs/*.jar app.jar

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD wget -qO- http://localhost:8080/actuator/health || exit 1

USER appuser

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
