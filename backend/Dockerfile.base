# =============================================================================
# Base builder image with JDK 21 and pre-cached Gradle 8.14 distribution
# Build once: docker build -f backend/Dockerfile.base -t exam/builder-base .
# Reused by all service Dockerfiles.
# Uses the Gradle wrapper from the project for version consistency.
# =============================================================================
FROM eclipse-temurin:21-jdk

WORKDIR /workspace

# Copy Gradle wrapper and local distribution zip
COPY gradlew ./
COPY gradle/ gradle/
COPY backend/gradle/gradle-8.14.5-bin.zip /tmp/gradle-8.14.5-bin.zip

# Pre-extract local Gradle distribution into /root/.gradle wrapper cache
RUN sed -i 's/\r$//' gradlew && \
    chmod +x gradlew && \
    sed -i 's|distributionUrl=.*|distributionUrl=file\:/tmp/gradle-8.14.5-bin.zip|' gradle/wrapper/gradle-wrapper.properties && \
    sh ./gradlew --version && \
    rm -f /tmp/gradle-8.14.5-bin.zip
