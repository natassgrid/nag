# =============================================================================
# Multi-stage Dockerfile for Spring Boot 4.x GraalVM Native Images
# Usage: docker build -f backend/Dockerfile.native --build-arg SERVICE_NAME=monolith-app -t nag/monolith-app:native .
# Must be built from the repo root (context = .)
# =============================================================================

# --- Stage 1: Native Image Builder with GraalVM JDK ---
FROM ghcr.io/graalvm/native-image-community:21-ol9 AS builder
ARG SERVICE_NAME

WORKDIR /workspace

# Install essential build prerequisites without full system update to prevent OL9 glibc conflicts
RUN microdnf install -y --nodocs findutils git tar gzip && \
    microdnf clean all

# Copy Gradle wrapper and root configuration
COPY gradlew ./
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

# Copy local Gradle distribution to avoid network download during build
COPY backend/gradle/gradle-8.14.5-bin.zip /tmp/gradle-8.14.5-bin.zip

# Fix line endings, make executable, and point wrapper at local zip
RUN sed -i 's/\r$//' gradlew && \
    chmod +x gradlew && \
    sed -i 's|distributionUrl=.*|distributionUrl=file\\:/tmp/gradle-8.14.5-bin.zip|' gradle/wrapper/gradle-wrapper.properties

# Copy all backend source modules (for multi-project Gradle dependencies)
COPY backend/ backend/

# Run native compilation with ahead-of-time (AOT) optimizations
RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.gradle/wrapper \
    ./gradlew :backend:${SERVICE_NAME}:nativeCompile -x test --no-daemon

# --- Stage 2: Minimal Runtime Environment ---
FROM debian:12-slim

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=8080

# Install runtime dependencies (zlib for GraalVM binary, wget/curl for healthchecks, ca-certificates for TLS)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl wget zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -u 10001 -U -m appuser && \
    mkdir -p /app /data/asset-storage /data/scorecards && \
    chown -R appuser:appuser /app /data

WORKDIR /app

# Copy the compiled native executable from builder stage
COPY --from=builder --chown=appuser:appuser /workspace/backend/${SERVICE_NAME}/build/native/nativeCompile/${SERVICE_NAME} /app/server

# Expose microservice HTTP port
EXPOSE 8080

USER appuser

# Run the native binary directly (sub-50ms cold-start, ~35MB RSS footprint)
ENTRYPOINT ["/app/server"]
