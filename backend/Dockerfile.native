# =============================================================================
# Multi-stage Dockerfile for Spring Boot 4.x GraalVM Native Images
# Usage: docker build -f backend/Dockerfile.native --build-arg SERVICE_NAME=paper-generator -t nag/paper-generator:native .
# Must be built from the repo root (context = .)
# =============================================================================

# --- Stage 1: Native Image Builder with GraalVM JDK ---
FROM ghcr.io/graalvm/native-image-community:21-ol9 AS builder

ARG SERVICE_NAME

WORKDIR /workspace

# Install build prerequisites
RUN microdnf update -y && \
    microdnf install -y findutils git tar gzip && \
    microdnf clean all

# Copy Gradle wrapper and root configuration
COPY gradlew ./
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./

# Fix line endings and permissions
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew

# Copy all backend source modules (for multi-project Gradle dependencies)
COPY backend/ backend/

# Run native compilation with ahead-of-time (AOT) optimizations
RUN --mount=type=cache,target=/root/.gradle/caches \
    --mount=type=cache,target=/root/.gradle/wrapper \
    ./gradlew :backend:${SERVICE_NAME}:nativeCompile -x test --no-daemon

# --- Stage 2: Ultra-minimal Distroless Runtime ---
FROM gcr.io/distroless/cc-debian12:nonroot

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}
ENV PORT=8080

WORKDIR /app

# Copy the compiled native executable from builder stage
COPY --from=builder /workspace/backend/${SERVICE_NAME}/build/native/nativeCompile/${SERVICE_NAME} /app/server

# Expose microservice HTTP port
EXPOSE 8080

USER nonroot:nonroot

# Run the native binary directly (sub-50ms cold-start, ~35MB RSS footprint)
ENTRYPOINT ["/app/server"]
