# =============================================================================
# Open Source Government Examination Platform — Environment Variables
# Copy this file to .env and fill in values before running docker compose.
# NEVER commit the actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=exam_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=exam_platform

# -----------------------------------------------------------------------------
# Apache Kafka (Bitnami KRaft mode)
# -----------------------------------------------------------------------------
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092

# Bootstrap servers used by Spring Boot services inside the compose network
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Bootstrap servers used by tools running on the host machine
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:29092

# -----------------------------------------------------------------------------
# Redis Cluster
# -----------------------------------------------------------------------------
# The IP that cluster nodes announce to each other.
# Set to your host machine IP or the Docker bridge IP when running locally.
REDIS_CLUSTER_IP=127.0.0.1
REDIS_PASSWORD=change_me_redis_secret

# Comma-separated cluster nodes for Spring Boot RedisClusterConfiguration
REDIS_CLUSTER_NODES=127.0.0.1:6379,127.0.0.1:6380,127.0.0.1:6381,127.0.0.1:6382,127.0.0.1:6383,127.0.0.1:6384

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# Realm and client IDs used by services
KEYCLOAK_REALM=exam-realm
KEYCLOAK_CLIENT_ID=exam-backend
KEYCLOAK_CLIENT_SECRET=change_me_client_secret

# Issuer URI consumed by Spring Security OAuth2 resource servers
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/exam-realm

# -----------------------------------------------------------------------------
# HashiCorp Vault (dev mode)
# In production: replace with production Vault address and AppRole credentials
# -----------------------------------------------------------------------------
VAULT_PORT=8200
VAULT_ROOT_TOKEN=change_me_vault_root_token
VAULT_ADDR=http://vault:8200

# AppRole credentials (for production — leave empty in dev mode)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Transit engine mount path used by VaultCryptoService
VAULT_TRANSIT_PATH=transit

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin

# -----------------------------------------------------------------------------
# Jaeger / OpenTelemetry
# -----------------------------------------------------------------------------
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# OTLP exporter endpoint used by Spring Boot OpenTelemetry Java agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Service name set by each individual service (override per-service)
OTEL_SERVICE_NAME=exam-service

# -----------------------------------------------------------------------------
# Spring Boot common settings (applied across all backend services)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/exam_platform
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

SPRING_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}

SPRING_DATA_REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}
SPRING_DATA_REDIS_PASSWORD=${REDIS_PASSWORD}

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=${KEYCLOAK_ISSUER_URI}

SPRING_CLOUD_VAULT_URI=${VAULT_ADDR}
SPRING_CLOUD_VAULT_TOKEN=${VAULT_ROOT_TOKEN}
SPRING_CLOUD_VAULT_SCHEME=http

# -----------------------------------------------------------------------------
# Individual service ports (internal to exam-network)
# Change only if there are port conflicts on the host
# -----------------------------------------------------------------------------
IDENTITY_SERVICE_PORT=8081
CANDIDATE_SERVICE_PORT=8082
QUESTION_BANK_SERVICE_PORT=8083
TRANSLATION_SERVICE_PORT=8084
EXAMINATION_SERVICE_PORT=8085
PAPER_GENERATOR_PORT=8086
DELIVERY_SERVICE_PORT=8087
RESPONSE_SERVICE_PORT=8088
EVALUATION_SERVICE_PORT=8089
RESULT_SERVICE_PORT=8090
AUDIT_SERVICE_PORT=8091
NOTIFICATION_SERVICE_PORT=8092
ADMIN_SERVICE_PORT=8093
ANALYTICS_SERVICE_PORT=8094
API_GATEWAY_PORT=9000

# -----------------------------------------------------------------------------
# Email / Notification (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------------------
# DigiLocker integration
# -----------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=change_me
DIGILOCKER_CLIENT_SECRET=change_me
DIGILOCKER_REDIRECT_URI=http://localhost:9000/api/v1/candidate/digilocker/callback

# -----------------------------------------------------------------------------
# Security — general
# -----------------------------------------------------------------------------
# JWT access token lifetime (seconds) — max 900 per Req 23.4
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900

# JWT refresh token lifetime (seconds) — max 28800 per Req 23.4
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=28800

# Session idle timeout (seconds)
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Max failed auth attempts before lockout (Req 2.4)
AUTH_MAX_FAILED_ATTEMPTS=5

# Auth lockout window (seconds)
AUTH_LOCKOUT_WINDOW_SECONDS=600

# Rate limit: auth requests per IP per minute (Req 17.1)
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=10

# Rate limit: standard API clients per minute (Req 23.6)
RATE_LIMIT_STANDARD_PER_MINUTE=1000

# Auto-save interval for in-progress sessions (seconds, min 30 per Req 10.2)
AUTO_SAVE_INTERVAL_SECONDS=30

# Paper generation concurrency limit
PAPER_GEN_CONCURRENCY_LIMIT=10

# Question similarity rejection threshold (Req 4.7)
QUESTION_SIMILARITY_THRESHOLD=0.80

# Shift paper difficulty comparability tolerance (Req 8.9, as decimal fraction)
SHIFT_DIFFICULTY_TOLERANCE=0.02
