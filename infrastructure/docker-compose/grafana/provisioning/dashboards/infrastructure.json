{
  "dashboard": {
    "id": null,
    "uid": "infrastructure",
    "title": "Infrastructure",
    "tags": ["exam-platform", "infrastructure"],
    "timezone": "browser",
    "refresh": "15s",
    "schemaVersion": 39,
    "panels": [
      {
        "id": 1,
        "title": "JVM Heap Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{area=\"heap\"}) * 100",
            "legendFormat": "{{service}} Heap %"
          }
        ]
      },
      {
        "id": 2,
        "title": "GC Pause Duration (p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(jvm_gc_pause_seconds_bucket[5m])) by (le, service))",
            "legendFormat": "{{service}} GC p99"
          }
        ]
      },
      {
        "id": 3,
        "title": "Database Connection Pool",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum by (service) (hikaricp_connections_active)",
            "legendFormat": "{{service}} Active"
          },
          {
            "expr": "sum by (service) (hikaricp_connections_idle)",
            "legendFormat": "{{service}} Idle"
          }
        ]
      },
      {
        "id": 4,
        "title": "Kafka Consumer Lag",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum by (group) (kafka_consumer_lag)",
            "legendFormat": "{{group}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Redis Hit Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "sum(rate(redis_hits_total[5m])) / (sum(rate(redis_hits_total[5m])) + sum(rate(redis_misses_total[5m]))) * 100",
            "legendFormat": "Hit Rate %"
          }
        ]
      },
      {
        "id": 6,
        "title": "HTTP Request Rate by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "sum by (service) (rate(http_server_requests_seconds_count[5m])) * 60",
            "legendFormat": "{{service}} req/min"
          }
        ]
      }
    ],
    "time": { "from": "now-1h", "to": "now" }
  }
}
