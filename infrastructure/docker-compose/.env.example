# ─────────────────────────────────────────────────────────────────────────────
# NextGen Assessment Grid (NAG) - Environment Variables Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# -----------------------------------------------------------------------------
# Email / Notification (SMTP Server Configuration)
# -----------------------------------------------------------------------------
# Hostname or IP of the SMTP mail server (e.g., smtp.gmail.com, smtp.sendgrid.net, mailhog)
SMTP_HOST=smtp.gmail.com
MAIL_HOST=smtp.gmail.com

# SMTP port: 587 (TLS/STARTTLS), 465 (SSL), or 1025/25 (local Mailhog/dev)
SMTP_PORT=587
MAIL_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=notifications@example.com
MAIL_USERNAME=notifications@example.com
SMTP_PASSWORD=your-smtp-app-password-here
MAIL_PASSWORD=your-smtp-app-password-here

# Default From / Sender email address
SMTP_FROM=noreply@natassgrid.gov.in
MAIL_FROM=noreply@natassgrid.gov.in

# Application & Portal URLs for email verification and invitation links
ADMIN_PORTAL_URL=http://localhost:4200
CANDIDATE_PORTAL_URL=http://localhost:4300

# -----------------------------------------------------------------------------
# SMS Gateway (MSG91 - Optional for Candidate Mobile Verification)
# -----------------------------------------------------------------------------
SMS_ENABLED=false
MOBILE_VERIFICATION_REQUIRED=false
SMS_WEEKLY_LIMIT=3
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_SENDER_ID=NAGGov
MSG91_API_URL=http://mock-server:8099/api/v5/otp

# -----------------------------------------------------------------------------
# Mock DPI Third-Party API Server (DigiLocker, Aadhaar e-KYC, MSG91 for E2E)
# -----------------------------------------------------------------------------
MOCK_SERVER_PORT=8099
DIGILOCKER_API_URL=http://mock-server:8099/digilocker/v1/verify
DIGILOCKER_PUSH_URL=http://mock-server:8099/digilocker/v1/credential/push
DIGILOCKER_AUTH_URI=http://localhost:8099/digilocker/oauth/authorize
DIGILOCKER_TOKEN_URI=http://mock-server:8099/digilocker/oauth/token
DIGILOCKER_USERINFO_URI=http://mock-server:8099/digilocker/oauth/userinfo
AADHAAR_API_URL=http://mock-server:8099/aadhaar

# -----------------------------------------------------------------------------
# AI Models Configuration for Question Generation
# -----------------------------------------------------------------------------
# Active AI Provider: bedrock | gemini | local
AI_PROVIDER=bedrock

AI_MODEL_EASY=nova-micro
AI_MODEL_MEDIUM=nova-lite
AI_MODEL_HARD=nova-lite

# -----------------------------------------------------------------------------
# AWS Bedrock Configuration (required if AI_PROVIDER=bedrock)
# -----------------------------------------------------------------------------
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AI_BEDROCK_ROLE_ARN=arn:aws:iam::123456789012:role/service-role/nag-bedrock-execution-role
AI_BEDROCK_S3_BUCKET=nag-bedrock

# -----------------------------------------------------------------------------
# Google Gemini / Vertex AI Configuration (required if AI_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# Google AI Studio API Key
GEMINI_API_KEY=

# Google Vertex AI (Alternative Enterprise path)
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_FILE=

# Model Tier Mapping for Gemini (when AI_PROVIDER=gemini)
# AI_MODEL_EASY=gemini-flash-lite
# AI_MODEL_MEDIUM=gemini-flash
# AI_MODEL_HARD=gemini-pro
AI_GEMINI_MODEL_EASY=gemini-flash-lite
AI_GEMINI_MODEL_MEDIUM=gemini-flash
AI_GEMINI_MODEL_HARD=gemini-pro

# -----------------------------------------------------------------------------
# AI Agent Guardrails & Resilience Configuration (OWASP Top 10 for LLM)
# -----------------------------------------------------------------------------
AI_GUARDRAILS_ENABLED=true
AI_GUARDRAIL_STRICT_MODE=true

# Circuit Breaker & Upstream Resilience
AI_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
AI_CIRCUIT_BREAKER_WAIT_DURATION_SECONDS=30
AI_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
AI_CALL_TIMEOUT_SECONDS=45
AI_AGENT_MAX_REFINEMENT_CYCLES=2

# Token & Rate Limits per request
AI_MAX_PROMPT_INPUT_LENGTH=4000
AI_MAX_OUTPUT_TOKENS=2048

# -----------------------------------------------------------------------------
# IndicTrans2 Translation Model
# -----------------------------------------------------------------------------
# Defaulting to the ungated mirror so the container works out-of-the-box without requiring HF login / token:
INDICTRANS_MODEL=naklitechie/indictrans2-en-indic-dist-200M
# If you prefer the official repo (ai4bharat/indictrans2-en-indic-dist-200M), accept the license on HF and set your token:
# HF_TOKEN=hf_your_huggingface_token
