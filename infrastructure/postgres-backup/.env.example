# =============================================================================
# NAG PostgreSQL Backup & Disaster Recovery Pipeline Configuration Example
# Copy this file to .env and configure your environment:
# cp infrastructure/postgres-backup/.env.example infrastructure/postgres-backup/.env
# =============================================================================

# PostgreSQL Connection
# Use 'postgres' or 'exam-postgres' when running inside Docker network;
# Use 'localhost' when running from host machine against mapped port 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_admin
POSTGRES_PASSWORD=exam_secret

# AWS S3 / Lightsail Object Storage Configuration
AWS_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-backup-bucket
S3_PREFIX=backups/postgres
S3_STORAGE_CLASS=STANDARD_IA
AWS_ENDPOINT_URL=

# Backup & Compression Settings
# auto: prefers zstd -19, falls back to gzip -9
COMPRESSION_ALGO=auto
BACKUP_DIR=/tmp/nag-postgres-backups
RESTORE_WORK_DIR=/tmp/nag-postgres-restores
KEEP_LOCAL=false
NO_UPLOAD=false
SCHEMAS=

# Docker Sidecar Cron Schedule (UTC)
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Optional Alerts Webhook (Slack / Discord / SNS)
WEBHOOK_URL=
