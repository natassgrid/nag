# =============================================================================
# Git line-ending policy for the exam-platform monorepo.
#
# Rule of thumb:
#   - Shell scripts / gradlew     → always LF (must be executable on Linux)
#   - Windows batch files         → always CRLF
#   - Everything else             → LF (consistent across platforms)
# =============================================================================

# Default: normalise all text files to LF in the repo
* text=auto eol=lf

# Shell scripts — must be LF so they are executable inside WSL / CI containers
*.sh        text eol=lf
gradlew     text eol=lf

# Windows batch wrappers — keep CRLF so cmd.exe can execute them
*.bat       text eol=crlf
*.cmd       text eol=crlf
gradlew.bat text eol=crlf

# Java / Kotlin / Groovy / YAML / SQL / JSON / XML — always LF
*.java      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.groovy    text eol=lf
*.gradle    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
*.ts        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf

# Binary files — never mangle line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.jar       binary
*.zip       binary
*.tar.gz    binary
*.keystore  binary
*.p12       binary
