# =============================================================================
# Root .dockerignore for NAG Build Context Optimization
# Prevents multi-gigabyte local artifacts from being uploaded to Docker daemon
# =============================================================================

# Version control & IDE
.git
.gitignore
.gitattributes
.idea
.vscode
.agents
.gemini
.system_generated

# Node.js & Frontend Workspaces
node_modules
**/node_modules
nag-frontend-workspace/node_modules
nag-frontend-workspace/.nx/cache
nag-frontend-workspace/dist
nag-frontend-workspace/.angular
frontend/node_modules
frontend/dist
frontend/build
candidate-frontend/node_modules
candidate-frontend/dist
candidate-frontend/build

# Java / Gradle Build Artifacts (Docker builds cleanly inside container)
.gradle
**/.gradle
build
**/build
out
**/out
target
**/target
**/*.class
**/*.log

# Ensure gradle wrapper & distribution are never ignored
!gradle/wrapper/gradle-wrapper.jar
!backend/gradle/gradle-8.14.5-bin.zip

# Infrastructure runtime & AI Model caches
infrastructure/indictrans2/models
infrastructure/ollama
infrastructure/docker-compose/*_data
infrastructure/docker-compose/.env*

# Documentation & Specs
docs/
*.md
/docs/cpd/
